# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=bookleaf_jwt_super_secret_key_change_in_production_2026

# Client URL (for CORS and WebSocket origins)
CLIENT_URL=http://localhost:5173

# AI / LLM Configuration
# Supports OpenAI, Anthropic, or Gemini API keys.
# If no key is provided, the application runs on its built-in Intelligent Fallback Engine
# which uses the BookLeaf Knowledge Base rules and pattern matching with zero external failures!
AI_PROVIDER=fallback # 'openai' | 'anthropic' | 'gemini' | 'fallback'
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model override
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-1.5-flash
